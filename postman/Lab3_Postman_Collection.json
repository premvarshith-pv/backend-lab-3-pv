      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('All prices are between 100 and 500', function () {",
              "    const json = pm.response.json();",
              "    json.data.forEach(book => {",
              "        pm.expect(book.price).to.be.at.least(100);",
              "        pm.expect(book.price).to.be.at.most(500);",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
