  "item": [
    {
      "name": "TEST 1: GET /books (Retrieve All Books)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books",
          "host": ["{{baseUrl}}"],
          "path": ["books"]
        },
        "description": "Retrieve all books with default parameters (limit 10, offset 0, order_by id ASC)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Response has message and data array', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property('message', 'Books retrieved successfully');",
              "    pm.expect(json.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "TEST 2: GET /books?search_q=java (Search by Title)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?search_q=java",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "search_q",
              "value": "java"
            }
          ]
        },
        "description": "Search books whose title contains 'java' (case-insensitive LIKE search)."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('All returned books contain search query in title', function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.data).to.be.an('array');",
              "    json.data.forEach(book => {",
              "        pm.expect(book.title.toLowerCase()).to.include('java');",
              "    });",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "TEST 3: GET /books?order_by=price&order=DESC (Sorting)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/books?order_by=price&order=DESC",
          "host": ["{{baseUrl}}"],
          "path": ["books"],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "DESC"
            }
          ]
        },
        "description": "Sort books by price descending."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Prices are in descending order', function () {",
              "    const json = pm.response.json();",
              "    for (let i = 0; i < json.data.length - 1; i++) {",
              "        pm.expect(json.data[i].price).to.be.at.least(json.data[i + 1].price);",
              "    }",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
